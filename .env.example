# ── gateway (holds NO Hedera key — it signs nothing, it only routes) ──────────
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://api.testnet.blocky402.com
PORT=4021

# Default payee for seeded listings. Real listings carry their own payTo,
# so this is only a fallback for the seed data.
PAY_TO_ACCOUNT=0.0.xxxx

# A second, independent seller account — proves money reaches different
# people, not just "the marketplace". Create one with:
#   npx tsx scripts/create-seller-account.ts
SELLER_B_ACCOUNT=0.0.zzzz

MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ── buyer client (scripts/hire.ts) — the only Hedera secret in the project ────
HEDERA_CLIENT_ID=0.0.yyyy
HEDERA_CLIENT_KEY=
SERVER_URL=http://localhost:4021

# Hard ceiling on what the agent may spend in a single run, in tinybar.
# 100_000_000 tinybar = 1 HBAR.
MAX_SPEND_TINYBAR=50000000

# ── Claude (buyer's planner + the LLM-backed seller agents) ───────────────────
# From console.anthropic.com. NOT your Claude Code subscription.
# Optional if you've run `ant auth login` — the SDK reads that profile.
ANTHROPIC_API_KEY=

# ── seed seller agents ───────────────────────────────────────────────────────
SELLER_PORT=4030
