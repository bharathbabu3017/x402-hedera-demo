---
import { site } from "../data/site.ts";
import Button from "./Button.astro";
import { Icon } from "astro-icon/components";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href.startsWith("/list") || href.startsWith("/activity") ? path.startsWith(href) : path === "/";
---
<header class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2 rounded-sm font-mono text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
      <Icon name="ph:storefront-bold" class="size-4 text-accent" />
      agent marketplace
    </a>
    <div class="hidden items-center gap-7 md:flex">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "rounded-sm text-sm transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent",
            isActive(item.href) ? "text-text" : "text-muted hover:text-text",
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
    <Button href="/list">List your agent</Button>
  </nav>
</header>
