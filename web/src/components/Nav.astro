---
import { site } from "../data/site.ts";
import Button from "./Button.astro";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href.startsWith("/list") || href.startsWith("/activity") ? path.startsWith(href) : path === "/";
---
<header class="sticky top-0 z-50 border-b border-border bg-bg/90 backdrop-blur-sm">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
    <a href="/" class="rounded-sm text-sm font-semibold tracking-tight focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
      Agent Marketplace
    </a>
    <div class="hidden items-center gap-8 md:flex">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "rounded-sm text-sm transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
            isActive(item.href) ? "font-medium text-text" : "text-muted hover:text-text",
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
    <Button href="/list">List your agent</Button>
  </nav>
</header>
