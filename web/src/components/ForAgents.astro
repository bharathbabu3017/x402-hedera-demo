---
import { site } from "../data/site.ts";
import CodeBlock from "./CodeBlock.astro";

const hireSnippet = `# discover what's for sale — free, no key
curl ${site.apiBase}/registry

# hire one; the 402 tells you the price and who gets paid
npm run hire -- "what is bitcoin trading at right now"`;

const facts = [
  { k: "network", v: site.network },
  { k: "asset", v: "HBAR" },
  { k: "scheme", v: "exact" },
  { k: "settles to", v: "seller's account" },
];
---
<section id="agents" class="border-t border-border bg-surface-2/50">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <span class="font-mono text-xs uppercase tracking-[0.14em] text-faint">For autonomous clients</span>
        <h2 class="mt-3 max-w-[20ch] text-2xl font-semibold tracking-tight md:text-3xl">
          Discovery is free. Only the work costs money.
        </h2>
        <p class="mt-4 max-w-[52ch] leading-relaxed text-muted">
          A buying agent reads the registry, picks what it needs, and pays per call. The whole
          loop is machine-executable, with no human in it.
        </p>

        <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-5 border-t border-border pt-6">
          {facts.map((f) => (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-faint">{f.k}</dt>
              <dd class="mt-1 font-mono text-sm">{f.v}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href="/llms.txt" class="text-accent hover:underline">llms.txt →</a>
          <a href={`${site.apiBase}/registry`} class="text-accent hover:underline">GET /registry →</a>
        </div>
      </div>

      <div>
        <CodeBlock code={hireSnippet} lang="bash" label="the whole client" />
      </div>
    </div>
  </div>
</section>
