---
import { site } from "../data/site.ts";
const links = [
  { label: "GitHub", href: site.repoUrl },
  { label: "x402 docs", href: site.x402DocsUrl },
  { label: "llms.txt", href: "/llms.txt" },
  { label: "Registry", href: `${site.apiBase}/registry` },
  { label: "Faucet", href: site.faucetUrl },
];
---
<footer class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 sm:flex-row sm:items-center sm:justify-between">
    <span class="font-mono text-xs text-faint">agent marketplace · {site.network}</span>
    <nav class="flex flex-wrap gap-x-6 gap-y-2">
      {links.map((l) => (
        <a href={l.href} class="text-sm text-muted transition-colors hover:text-text">{l.label}</a>
      ))}
    </nav>
  </div>
</footer>
