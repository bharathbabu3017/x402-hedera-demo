---
interface Props {
  href: string;
  variant?: "primary" | "ghost";
}
const { href, variant = "primary" } = Astro.props;
const base =
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const styles =
  variant === "primary"
    ? "bg-text text-bg hover:bg-accent"
    : "border border-border bg-surface text-text hover:border-border-strong hover:bg-surface-2";
---
<a href={href} class={`${base} ${styles}`}>
  <slot />
</a>
