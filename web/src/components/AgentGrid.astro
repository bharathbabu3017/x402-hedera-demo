---
// Listings are fetched in the browser, not at build time — an agent listed
// during a demo must appear without a rebuild.
---
<section id="browse" class="mx-auto max-w-7xl px-6 py-16">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Agents for hire</h2>
      <p class="mt-2 text-muted">Pay per call. No account, no API key, no subscription.</p>
    </div>
    <label class="relative w-full sm:w-72">
      <span class="sr-only">Search agents</span>
      <input
        id="agent-search"
        type="search"
        placeholder="Search by capability…"
        class="w-full rounded-full border border-border bg-surface/60 px-4 py-2.5 text-sm text-text placeholder:text-faint backdrop-blur transition focus:border-accent/50 focus:outline-none"
      />
    </label>
  </div>

  <div id="agent-status" class="mt-10 text-sm text-muted">Loading agents…</div>
  <div id="agent-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
</section>

<script>
  import { getRegistry, GatewayDown, type Listing } from "../lib/api.ts";
  import { formatHbar } from "../lib/format.ts";
  import { site } from "../data/site.ts";

  const grid = document.getElementById("agent-grid")!;
  const status = document.getElementById("agent-status")!;
  const search = document.getElementById("agent-search") as HTMLInputElement;

  const escape = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
    );

  const card = (l: Listing) => `
    <a href="/agent?slug=${encodeURIComponent(l.slug)}"
       class="card-glow group flex flex-col rounded-xl border border-border bg-surface/60 p-5 backdrop-blur transition hover:border-accent/40">
      <div class="flex items-start justify-between gap-3">
        <h3 class="font-medium leading-tight text-text">${escape(l.name)}</h3>
        <span class="shrink-0 rounded-full border border-accent/30 bg-accent/10 px-2.5 py-1 font-mono text-xs text-accent">
          ${formatHbar(l.priceTinybar)}
        </span>
      </div>
      <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">${escape(l.description)}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        ${l.tags.map((t) => `<span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-faint">${escape(t)}</span>`).join("")}
      </div>
      <div class="mt-5 flex items-center justify-between border-t border-border/60 pt-4 font-mono text-xs text-faint">
        <span>${l.calls} ${l.calls === 1 ? "call" : "calls"} · earned ${formatHbar(l.earnedTinybar)}</span>
        <span class="text-muted transition group-hover:text-accent">${escape(l.payToAccount)}</span>
      </div>
    </a>`;

  let all: Listing[] = [];

  const render = () => {
    const q = search.value.trim().toLowerCase();
    const shown = q
      ? all.filter((l) =>
          `${l.name} ${l.description} ${l.tags.join(" ")}`.toLowerCase().includes(q),
        )
      : all;

    grid.innerHTML = shown.map(card).join("");
    status.textContent = shown.length
      ? `${shown.length} of ${all.length} agents`
      : q
        ? `No agents match “${search.value.trim()}”.`
        : "No agents listed yet.";
  };

  try {
    all = await getRegistry();
    render();
    search.addEventListener("input", render);
  } catch (err) {
    grid.innerHTML = "";
    status.innerHTML =
      err instanceof GatewayDown
        ? `<span class="text-text">Can't reach the marketplace at <code class="font-mono text-accent">${site.apiBase}</code>.</span>
           <br />Start it with <code class="font-mono text-accent">npm run dev</code>.`
        : `Failed to load agents: ${(err as Error).message}`;
  }
</script>
