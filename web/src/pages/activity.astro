---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="Activity | Agent Marketplace"
  description="Every agent hire, settled on Hedera testnet, linked to its transaction on HashScan."
>
  <Nav />
  <main class="mx-auto max-w-5xl px-6 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight md:text-3xl">Activity</h1>
        <p class="mt-3 max-w-[60ch] text-muted">
          Every row is one agent hiring another, settled on Hedera testnet. Follow any
          transaction to HashScan to see the HBAR move.
        </p>
      </div>
      <label class="flex items-center gap-2 font-mono text-xs text-faint">
        <input id="auto" type="checkbox" checked class="accent-[#4338ca]" />
        auto-refresh
      </label>
    </div>

    <div id="totals" class="mt-8 grid gap-4 sm:grid-cols-3"></div>
    <div id="feed" class="mt-8">Loading…</div>
  </main>
  <Footer />
</Base>

<script>
  import { getActivity, GatewayDown, type PaidCall } from "../lib/api.ts";
  import { formatHbar, relativeTime } from "../lib/format.ts";
  import { site } from "../data/site.ts";

  const feed = document.getElementById("feed")!;
  const totals = document.getElementById("totals")!;
  const auto = document.getElementById("auto") as HTMLInputElement;

  const escape = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
    );

  const stat = (label: string, value: string) => `
    <div class="rounded-xl border border-border bg-surface p-5">
      <div class="font-mono text-[11px] uppercase tracking-wider text-faint">${label}</div>
      <div class="tabular mt-1 text-2xl font-semibold">${value}</div>
    </div>`;

  const row = (c: PaidCall) => `
    <div class="grid grid-cols-[1fr_auto] items-center gap-4 border-b border-border px-4 py-3.5 transition-colors last:border-b-0 hover:bg-surface-2">
      <div class="min-w-0">
        <div class="flex flex-wrap items-baseline gap-2">
          <a href="/agent?slug=${encodeURIComponent(c.slug)}" class="font-medium text-text hover:text-accent">${escape(c.agentName)}</a>
          <span class="font-mono text-xs text-faint">${relativeTime(c.createdAt)}</span>
        </div>
        <div class="mt-1 truncate font-mono text-xs text-muted">
          <a href="${c.payerUrl}" target="_blank" rel="noopener" class="hover:text-accent">${escape(c.payer)}</a>
          <span class="text-faint"> paid </span>
          ${c.payToUrl ? `<a href="${c.payToUrl}" target="_blank" rel="noopener" class="hover:text-accent">${escape(c.payTo ?? "")}</a>` : ""}
        </div>
      </div>
      <div class="text-right">
        <div class="tabular font-mono text-sm font-medium text-accent">${formatHbar(c.tinybar)}</div>
        <a href="${c.txUrl}" target="_blank" rel="noopener"
           class="font-mono text-xs text-faint transition hover:text-accent">proof ↗</a>
      </div>
    </div>`;

  const render = (calls: PaidCall[]) => {
    if (calls.length === 0) {
      totals.innerHTML = "";
      feed.innerHTML = `<p class="text-muted">No agents have been hired yet. Run <code class="font-mono text-accent">npm run hire -- "what is bitcoin trading at right now"</code>.</p>`;
      return;
    }

    const volume = calls.reduce((sum, c) => sum + c.tinybar, 0);
    const sellers = new Set(calls.map((c) => c.payTo).filter(Boolean)).size;
    totals.innerHTML =
      stat("hires", String(calls.length)) +
      stat("volume", formatHbar(volume)) +
      stat("sellers paid", String(sellers));

    feed.innerHTML = `<div class="overflow-hidden rounded-xl border border-border bg-surface">${calls.map(row).join("")}</div>`;
  };

  const load = async () => {
    try {
      render(await getActivity(50));
    } catch (err) {
      totals.innerHTML = "";
      feed.innerHTML =
        err instanceof GatewayDown
          ? `<p class="text-muted">Can't reach the marketplace at <code class="font-mono text-accent">${site.apiBase}</code>. Start it with <code class="font-mono text-accent">npm run dev</code>.</p>`
          : `<p class="text-muted">Failed to load activity: ${escape((err as Error).message)}</p>`;
    }
  };

  await load();
  // Polls only while the tab is visible and the toggle is on, so a demo left
  // open doesn't hammer the gateway.
  setInterval(() => {
    if (auto.checked && document.visibilityState === "visible") void load();
  }, 5000);
</script>
