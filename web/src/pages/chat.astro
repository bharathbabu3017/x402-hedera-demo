---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import WalletBar from "../components/WalletBar.astro";

const examples = [
  { label: "Live market price", task: "What is bitcoin trading at right now?" },
  { label: "Two agents, chained", task: "Read https://hedera.com/blog and tell me whether the tone is positive or negative" },
  { label: "Structured extraction", task: "Pull the people, organizations and locations out of this: Ada Lovelace worked with Charles Babbage in London in 1843." },
];
---
<Base
  title="Chat | Agent Marketplace"
  description="Give a task in plain English. The buying agent picks which marketplace agents to hire, pays them in HBAR, and shows the 402 challenge and settlement for every call."
>
  <Nav />
  <main class="mx-auto flex min-h-[calc(100dvh-3.5rem)] max-w-4xl flex-col px-6">
    <WalletBar>
      <label class="flex cursor-pointer items-center gap-2 font-mono text-[11px] text-muted">
        <input id="show-protocol" type="checkbox" checked class="accent-[#4338ca]" />
        show protocol
      </label>
    </WalletBar>

    <!-- transcript -->
    <div id="transcript" class="flex-1 space-y-4 py-8">
      <div id="empty-state">
        <h1 class="text-2xl font-semibold tracking-tight">Hire an agent</h1>
        <p class="mt-2 max-w-[58ch] leading-relaxed text-muted">
          Describe a task. The buying agent reads the marketplace, decides who to hire, shows you
          the cost before spending anything, then pays per call in HBAR — including the raw
          <code class="font-mono text-text">402</code> challenge it got back.
        </p>
        <div class="mt-6 grid gap-2 sm:grid-cols-3">
          {examples.map((ex) => (
            <button type="button" data-example={ex.task}
              class="card rounded-xl border border-border bg-surface p-3 text-left">
              <div class="font-mono text-[10px] uppercase tracking-wider text-faint">{ex.label}</div>
              <div class="mt-1.5 text-sm leading-snug text-muted">{ex.task}</div>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- composer -->
    <form id="composer" class="sticky bottom-0 border-t border-border bg-bg py-4">
      <div class="flex gap-3">
        <input id="task" name="task" autocomplete="off" placeholder="Ask for something…"
          class="field flex-1 rounded-lg border border-border bg-surface px-4 py-2.5 text-sm text-text placeholder:text-faint" />
        <button type="submit" id="send"
          class="rounded-lg bg-text px-5 py-2.5 text-sm font-medium text-bg transition-colors hover:bg-accent disabled:opacity-40">
          Send
        </button>
      </div>
      <p class="mt-2 font-mono text-[11px] text-faint">
        Real HBAR on Hedera testnet. Key read from <code>.env</code> — demo only.
      </p>
    </form>
  </main>
</Base>

<script>
  import { streamChat, GatewayDown, type BuyerEvent } from "../lib/api.ts";
  import { formatHbar } from "../lib/format.ts";
  import { site } from "../data/site.ts";

  const transcript = document.getElementById("transcript")!;
  const emptyState = document.getElementById("empty-state");
  const form = document.getElementById("composer") as HTMLFormElement;
  const input = document.getElementById("task") as HTMLInputElement;
  const send = document.getElementById("send") as HTMLButtonElement;
  const showProtocol = document.getElementById("show-protocol") as HTMLInputElement;

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
    );

  const json = (v: unknown) => esc(JSON.stringify(v, null, 2));

  // ── transcript ────────────────────────────────────────────────────────────
  const scroll = () => window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });

  const append = (html: string): HTMLElement => {
    const wrap = document.createElement("div");
    wrap.innerHTML = html;
    const node = wrap.firstElementChild as HTMLElement;
    transcript.append(node);
    scroll();
    return node;
  };

  /** A collapsible block of raw protocol JSON. */
  const details = (summary: string, badge: string, payload: unknown, open = false) => `
    <details ${open ? "open" : ""} class="protocol group/d mt-3 rounded-lg border border-border bg-surface-2/60">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2">
        <span class="font-mono text-[11px] text-muted">${summary}</span>
        <span class="font-mono text-[10px] uppercase tracking-wider text-faint">${badge}</span>
      </summary>
      <pre class="overflow-x-auto border-t border-border px-3 py-2.5 font-mono text-[11px] leading-relaxed text-muted"><code>${json(payload)}</code></pre>
    </details>`;

  const applyProtocolVisibility = () => {
    document.querySelectorAll<HTMLElement>(".protocol").forEach((el) => {
      el.style.display = showProtocol.checked ? "" : "none";
    });
  };
  showProtocol.addEventListener("change", applyProtocolVisibility);

  // ── event rendering ───────────────────────────────────────────────────────
  const renderEvent = (event: BuyerEvent, steps: Map<number, HTMLElement>) => {
    switch (event.type) {
      case "thinking":
        append(`<div id="thinking" class="flex items-center gap-2 text-sm text-muted">
          <span class="size-1.5 animate-pulse rounded-full bg-accent"></span>
          Reading the marketplace and choosing who to hire…
        </div>`);
        return;

      case "plan": {
        document.getElementById("thinking")?.remove();
        const rows = event.plan.steps
          .map((s, i) => {
            const chained =
              s.usesOutputOf !== null
                ? `<span class="ml-1.5 rounded border border-border px-1 py-px font-mono text-[10px] text-faint">← step ${s.usesOutputOf + 1}</span>`
                : "";
            return `<li class="flex gap-3">
              <span class="tabular mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full border border-accent font-mono text-[10px] text-accent">${i + 1}</span>
              <div class="min-w-0">
                <div class="font-mono text-sm text-text">${esc(s.slug)}${chained}</div>
                <div class="mt-0.5 text-sm leading-relaxed text-muted">${esc(s.reason)}</div>
              </div>
            </li>`;
          })
          .join("");

        append(`<div class="rounded-xl border border-border bg-surface p-5">
          <div class="flex items-center justify-between gap-3">
            <span class="font-mono text-[10px] uppercase tracking-wider text-faint">Plan</span>
            <span class="tabular font-mono text-xs text-muted">${formatHbar(event.projectedTinybar)} of ${formatHbar(event.budgetTinybar)} budget</span>
          </div>
          <p class="mt-2 text-sm leading-relaxed">${esc(event.plan.reasoning)}</p>
          <ul class="mt-4 space-y-3">${rows}</ul>
        </div>`);
        return;
      }

      case "refused":
        append(`<div class="rounded-xl border border-red-200 bg-red-50 p-5">
          <div class="text-sm font-medium text-red-700">Refused — over budget</div>
          <p class="mt-1.5 text-sm leading-relaxed text-red-700">
            This plan would cost ${formatHbar(event.projectedTinybar)}, over the
            ${formatHbar(event.budgetTinybar)} budget. <strong>Nothing was paid.</strong>
          </p>
          <ul class="mt-3 space-y-1 font-mono text-xs text-red-700">
            ${event.skipped.map((s) => `<li>skipped · ${esc(s)}</li>`).join("")}
          </ul>
        </div>`);
        return;

      case "step-start": {
        const node = append(`<div class="rounded-xl border border-border bg-surface p-4">
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-2.5">
              <span class="tabular flex size-5 items-center justify-center rounded-full border border-border font-mono text-[10px] text-muted">${event.index + 1}</span>
              <span class="text-sm font-medium">${esc(event.name)}</span>
            </div>
            <span data-status class="font-mono text-xs text-faint">
              <span class="mr-1.5 inline-block size-1.5 animate-pulse rounded-full bg-faint align-middle"></span>hiring
            </span>
          </div>
          <div data-body></div>
        </div>`);
        steps.set(event.index, node);
        return;
      }

      case "step-402": {
        const node = steps.get(event.index);
        if (!node) return;
        const accepts = (event.challenge as { accepts?: Array<Record<string, unknown>> })?.accepts?.[0];
        const summary = accepts
          ? `402 · ${accepts["amount"]} tinybar → ${accepts["payTo"]}`
          : "402 payment required";
        node.querySelector("[data-status]")!.innerHTML =
          `<span class="text-muted">402 · paying</span>`;
        node.querySelector("[data-body]")!.insertAdjacentHTML(
          "beforeend",
          details(summary, "payment-required", event.challenge),
        );
        applyProtocolVisibility();
        return;
      }

      case "step-paid": {
        const node = steps.get(event.index);
        if (!node) return;
        node.querySelector("[data-status]")!.innerHTML =
          `<span class="tabular font-medium text-accent">paid ${formatHbar(event.priceTinybar)}</span>`;
        node.querySelector("[data-body]")!.insertAdjacentHTML(
          "beforeend",
          `<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11px]">
             <span class="text-faint">→ ${esc(event.payTo)}</span>
             <a href="${event.txUrl}" target="_blank" rel="noopener" class="text-accent hover:underline">HashScan ↗</a>
           </div>` + details("200 · settled on Hedera", "payment-response", event.settlement),
        );
        applyProtocolVisibility();
        return;
      }

      case "step-result": {
        const node = steps.get(event.index);
        if (!node) return;
        node
          .querySelector("[data-body]")!
          .insertAdjacentHTML("beforeend", details("agent response", "200 body", event.result));
        applyProtocolVisibility();
        return;
      }

      case "step-failed": {
        const node = steps.get(event.index);
        if (!node) return;
        node.querySelector("[data-status]")!.innerHTML =
          `<span class="font-medium text-red-600">failed</span>`;
        node.querySelector("[data-body]")!.insertAdjacentHTML(
          "beforeend",
          `<p class="mt-2 text-sm text-red-600">${esc(event.message)}</p>
           <p class="mt-1 font-mono text-[11px] text-faint">nothing was charged for this call</p>`,
        );
        return;
      }

      case "done": {
        if (event.result !== null && event.result !== undefined) {
          const body =
            typeof event.result === "string" ? esc(event.result) : json(event.result);
          append(`<div class="overflow-hidden rounded-xl border border-accent/30 bg-surface">
            <div class="flex items-center justify-between border-b border-border bg-accent-wash px-4 py-2">
              <span class="font-mono text-[10px] uppercase tracking-wider text-accent">Result</span>
              <span class="tabular font-mono text-[11px] text-muted">spent ${formatHbar(event.spentTinybar)}</span>
            </div>
            <pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-text"><code>${body}</code></pre>
          </div>`);
        } else {
          append(`<p class="tabular font-mono text-xs text-faint">spent ${formatHbar(event.spentTinybar)}</p>`);
        }
        return;
      }

      case "error":
        document.getElementById("thinking")?.remove();
        append(`<p class="text-sm text-red-600">${esc(event.message)}</p>`);
        return;
    }
  };

  // ── run ───────────────────────────────────────────────────────────────────
  const run = async (task: string) => {
    emptyState?.remove();
    append(`<div class="flex justify-end">
      <div class="max-w-[75%] rounded-xl rounded-br-sm bg-text px-4 py-2.5 text-sm text-bg">${esc(task)}</div>
    </div>`);

    input.value = "";
    send.disabled = true;
    input.disabled = true;

    const steps = new Map<number, HTMLElement>();
    try {
      for await (const event of streamChat(task)) {
        renderEvent(event, steps);
        scroll();
      }
    } catch (err) {
      document.getElementById("thinking")?.remove();
      append(
        `<p class="text-sm text-red-600">${
          err instanceof GatewayDown
            ? `Can't reach the buying agent at <code class="font-mono">${site.buyerBase}</code>. Start it with <code class="font-mono">npm run buyer</code>.`
            : esc((err as Error).message)
        }</p>`,
      );
    } finally {
      send.disabled = false;
      input.disabled = false;
      input.focus();
      // The balance moves as a result of the run, so re-read it after.
      window.dispatchEvent(new Event("wallet:refresh"));
    }
  };

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const task = input.value.trim();
    if (task) void run(task);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-example]").forEach((btn) => {
    btn.addEventListener("click", () => void run(btn.dataset["example"]!));
  });

  input.focus();
</script>
