---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WalletBar from "../components/WalletBar.astro";

// Rendered client-side from ?slug=…, because an agent listed during a demo
// must have a working page without a rebuild.
---
<Base title="Agent | Agent Marketplace" description="Agent detail, pricing and live earnings.">
  <Nav />
  <main class="mx-auto max-w-5xl px-6">
    <WalletBar />
    <a href="/agents" class="mt-8 inline-block font-mono text-sm text-muted transition-colors hover:text-accent">← all agents</a>
    <div id="agent-detail" class="mt-6 pb-16 text-muted">Loading…</div>
  </main>
  <Footer />
</Base>

<script>
  import { getListing, streamHire, GatewayDown, type BuyerEvent, type Listing } from "../lib/api.ts";
  import { formatHbar, hashscanAccount, relativeTime } from "../lib/format.ts";
  import { site } from "../data/site.ts";

  const root = document.getElementById("agent-detail")!;
  const slug = new URLSearchParams(location.search).get("slug");

  const escape = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
    );

  const render = (l: Listing) => {
    document.title = `${l.name} | Agent Marketplace`;

    const fields = Object.entries(l.inputSchema);
    const exampleBody = Object.fromEntries(
      fields.map(([name, spec]) => [name, spec.type === "number" ? 1 : `<${name}>`]),
    );

    const curl = `curl -X POST ${site.apiBase}/a/${l.slug} \\
  -H 'content-type: application/json' \\
  -d '${JSON.stringify(exampleBody)}'
# → 402 payment required (${formatHbar(l.priceTinybar)} to ${l.payToAccount})`;

    root.innerHTML = `
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-semibold tracking-tight text-text md:text-3xl">${escape(l.name)}</h1>
          <p class="mt-1 font-mono text-sm text-faint">${escape(l.slug)}</p>
        </div>
        <span class="tabular rounded-lg border border-border bg-surface px-3.5 py-1.5 font-mono text-sm font-medium text-accent">
          ${formatHbar(l.priceTinybar)} per call
        </span>
      </div>

      <p class="mt-6 max-w-[70ch] leading-relaxed text-muted">${escape(l.description)}</p>

      <div class="mt-4 flex flex-wrap gap-1.5">
        ${l.tags.map((t) => `<span class="rounded border border-border px-1.5 py-0.5 font-mono text-[11px] text-faint">${escape(t)}</span>`).join("")}
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-border bg-surface p-5">
          <div class="font-mono text-xs text-faint">calls</div>
          <div class="tabular mt-1 text-2xl font-semibold">${l.calls}</div>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <div class="font-mono text-xs text-faint">earned</div>
          <div class="tabular mt-1 text-2xl font-semibold text-accent">${formatHbar(l.earnedTinybar)}</div>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <div class="font-mono text-xs text-faint">listed</div>
          <div class="tabular mt-1 text-2xl font-semibold">${relativeTime(l.createdAt)}</div>
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-border bg-surface-2/60 p-5">
        <div class="font-mono text-xs text-faint">paid directly to</div>
        <a href="${hashscanAccount(l.payToAccount)}" target="_blank" rel="noopener"
           class="mt-1 inline-flex items-center gap-2 font-mono text-accent transition hover:underline">
          ${escape(l.payToAccount)}
          <span aria-hidden="true">↗</span>
        </a>
        <p class="mt-2 text-sm text-muted">
          The marketplace never holds this money — it settles straight into the seller's account.
        </p>
      </div>

      <h2 class="mt-12 text-lg font-medium">Inputs</h2>
      ${
        fields.length === 0
          ? `<p class="mt-3 text-sm text-muted">This agent takes no input.</p>`
          : `<div class="mt-3 overflow-hidden rounded-xl border border-border">
              <table class="w-full text-left text-sm">
                <thead class="bg-surface-2 font-mono text-xs text-faint">
                  <tr><th class="px-4 py-2">field</th><th class="px-4 py-2">type</th><th class="px-4 py-2">description</th></tr>
                </thead>
                <tbody class="divide-y divide-border">
                  ${fields
                    .map(
                      ([name, spec]) => `<tr class="bg-surface">
                        <td class="px-4 py-3 font-mono text-text">${escape(name)}${spec.required ? '<span class="text-accent"> *</span>' : ""}</td>
                        <td class="px-4 py-3 font-mono text-muted">${escape(spec.type)}</td>
                        <td class="px-4 py-3 text-muted">${escape(spec.description)}</td>
                      </tr>`,
                    )
                    .join("")}
                </tbody>
              </table>
            </div>`
      }

      <h2 class="mt-12 text-lg font-medium">Try it</h2>
      <p class="mt-1.5 text-sm text-muted">
        Runs a real hire from the demo wallet — ${formatHbar(l.priceTinybar)} of testnet HBAR,
        settled on Hedera.
      </p>
      <form id="try-form" class="mt-4 rounded-xl border border-border bg-surface p-5">
        <div class="grid gap-4">
          ${
            fields.length === 0
              ? `<p class="text-sm text-muted">This agent takes no input.</p>`
              : fields
                  .map(
                    ([name, spec]) => `<div>
                      <label class="block font-mono text-[11px] uppercase tracking-[0.14em] text-faint" for="in-${escape(name)}">
                        ${escape(name)}${spec.required ? '<span class="text-accent"> *</span>' : ""}
                      </label>
                      <input id="in-${escape(name)}" data-field="${escape(name)}" data-type="${escape(spec.type)}"
                        ${spec.required ? "required" : ""}
                        class="field mt-2 w-full rounded-lg border border-border bg-surface px-3.5 py-2 text-sm text-text placeholder:text-faint"
                        placeholder="${escape(spec.description)}" />
                    </div>`,
                  )
                  .join("")
          }
        </div>
        <div class="mt-4 flex items-center gap-3">
          <button type="submit" id="try-run"
            class="rounded-lg bg-text px-4 py-2 text-sm font-medium text-bg transition-colors hover:bg-accent disabled:opacity-40">
            Hire for ${formatHbar(l.priceTinybar)}
          </button>
          <span id="try-status" class="font-mono text-xs text-faint"></span>
        </div>
        <div id="try-output" class="mt-4 space-y-3"></div>
      </form>

      <h2 class="mt-12 text-lg font-medium">Or from the command line</h2>
      <div class="mt-3 overflow-hidden rounded-xl border border-border bg-surface">
        <pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-text"><code>${escape(curl)}</code></pre>
      </div>

      ${
        l.outputExample
          ? `<h2 class="mt-12 text-lg font-medium">Example output</h2>
             <div class="mt-3 overflow-hidden rounded-xl border border-border bg-surface">
               <pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-muted"><code>${escape(JSON.stringify(l.outputExample, null, 2))}</code></pre>
             </div>`
          : ""
      }
    `;
  };

  /** Streams a direct hire and renders the protocol exchange inline. */
  const wireTryForm = (listing: Listing) => {
    const form = document.getElementById("try-form") as HTMLFormElement | null;
    if (!form) return;
    const runBtn = document.getElementById("try-run") as HTMLButtonElement;
    const statusEl = document.getElementById("try-status")!;
    const outputEl = document.getElementById("try-output")!;

    const block = (summary: string, badge: string, payload: unknown) => `
      <details class="rounded-lg border border-border bg-surface-2/60">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2">
          <span class="font-mono text-[11px] text-muted">${summary}</span>
          <span class="font-mono text-[10px] uppercase tracking-wider text-faint">${badge}</span>
        </summary>
        <pre class="overflow-x-auto border-t border-border px-3 py-2.5 font-mono text-[11px] leading-relaxed text-muted"><code>${escape(JSON.stringify(payload, null, 2))}</code></pre>
      </details>`;

    form.addEventListener("submit", async (submitEvent) => {
      submitEvent.preventDefault();

      const input: Record<string, unknown> = {};
      form.querySelectorAll<HTMLInputElement>("[data-field]").forEach((el) => {
        const raw = el.value.trim();
        if (!raw) return;
        input[el.dataset["field"]!] = el.dataset["type"] === "number" ? Number(raw) : raw;
      });

      runBtn.disabled = true;
      outputEl.innerHTML = "";
      statusEl.textContent = "requesting…";

      try {
        for await (const event of streamHire(listing.slug, input) as AsyncGenerator<BuyerEvent>) {
          if (event.type === "step-402") {
            statusEl.innerHTML = `<span class="text-muted">402 — paying</span>`;
            outputEl.insertAdjacentHTML("beforeend", block("402 payment required", "payment-required", event.challenge));
          } else if (event.type === "step-paid") {
            statusEl.innerHTML = `<span class="text-accent">paid ${formatHbar(event.priceTinybar)}</span>`;
            outputEl.insertAdjacentHTML(
              "beforeend",
              `<div class="flex flex-wrap gap-x-4 font-mono text-[11px]">
                 <span class="text-faint">→ ${escape(event.payTo)}</span>
                 <a href="${event.txUrl}" target="_blank" rel="noopener" class="text-accent hover:underline">HashScan ↗</a>
               </div>` + block("200 settled on Hedera", "payment-response", event.settlement),
            );
          } else if (event.type === "step-result") {
            outputEl.insertAdjacentHTML(
              "beforeend",
              `<div class="overflow-hidden rounded-lg border border-accent/30 bg-surface">
                 <div class="border-b border-border bg-accent-wash px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider text-accent">Result</div>
                 <pre class="overflow-x-auto p-3 font-mono text-[12px] leading-relaxed text-text"><code>${escape(JSON.stringify(event.result, null, 2))}</code></pre>
               </div>`,
            );
          } else if (event.type === "step-failed") {
            statusEl.innerHTML = `<span class="text-red-600">failed</span>`;
            outputEl.insertAdjacentHTML(
              "beforeend",
              `<p class="text-sm text-red-600">${escape(event.message)}</p>
               <p class="font-mono text-[11px] text-faint">nothing was charged</p>`,
            );
          } else if (event.type === "refused") {
            statusEl.innerHTML = `<span class="text-red-600">over budget</span>`;
          } else if (event.type === "error") {
            statusEl.innerHTML = `<span class="text-red-600">${escape(event.message)}</span>`;
          }
        }
      } catch (err) {
        statusEl.innerHTML =
          err instanceof GatewayDown
            ? `<span class="text-red-600">buying agent offline — run npm run buyer</span>`
            : `<span class="text-red-600">${escape((err as Error).message)}</span>`;
      } finally {
        runBtn.disabled = false;
        window.dispatchEvent(new Event("wallet:refresh"));
      }
    });
  };

  if (!slug) {
    root.innerHTML = `<p class="text-muted">No agent specified. <a href="/#browse" class="text-accent hover:underline">Browse all agents</a>.</p>`;
  } else {
    try {
      const listing = await getListing(slug);
      render(listing);
      wireTryForm(listing);
    } catch (err) {
      root.innerHTML =
        err instanceof GatewayDown
          ? `<p class="text-muted">Can't reach the marketplace at <code class="font-mono text-accent">${site.apiBase}</code>. Start it with <code class="font-mono text-accent">npm run dev</code>.</p>`
          : `<p class="text-muted">No agent called <code class="font-mono text-accent">${escape(slug)}</code> is listed. <a href="/#browse" class="text-accent hover:underline">Browse all agents</a>.</p>`;
    }
  }
</script>
