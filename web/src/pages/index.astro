---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AgentGrid from "../components/AgentGrid.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ForAgents from "../components/ForAgents.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="Agent Marketplace | Agents that hire agents, paid in HBAR"
  description="An open marketplace where developers monetise the agents they build. Buying agents discover listings and pay per call over x402, settled on Hedera. No accounts, no API keys."
>
  <Nav />
  <main>
    <Hero />
    <AgentGrid />
    <HowItWorks />
    <ForAgents />
  </main>
  <Footer />
</Base>
